---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeUrl = `${base}Maxwell_Alexander_Resume.pdf`;

const highlights = [
  {
    num: '01',
    tag: 'Programs & Events · 2026',
    title: 'Chandler Chamber of Commerce',
    body: 'Planned and executed Chamber programs and networking events alongside local partners including Intel, Waymo and Northrop Grumman.',
  },
  {
    num: '02',
    tag: 'Leadership · QuikTrip',
    title: 'Strategy meeting with a U.S. Congressman',
    body: 'Selected to meet with a U.S. Congressman and QuikTrip corporate leaders to discuss future company strategy.',
  },
  {
    num: '03',
    tag: 'Certification · 2025',
    title: 'AWS Cloud Foundations',
    body: 'Cloud principles, AWS global infrastructure, identity management (IAM), network security, encryption and compliance controls.',
  },
];

const stats = [
  { value: '2027', label: 'B.S. Business (AI), Arizona State' },
  { value: '5+ yrs', label: 'Professional work experience' },
  { value: 'AWS', label: 'Cloud Foundations certified' },
];

const experience = [
  {
    when: 'Feb — Aug 2026',
    role: 'Programs & Events Intern',
    org: 'Chandler Chamber of Commerce',
    note: 'Coordinated events with partners including Intel, Waymo and Northrop Grumman; maintained member and event databases in Excel.',
  },
  {
    when: '2024 — Present',
    role: 'Store Clerk',
    org: 'QuikTrip',
    note: 'Trains and onboards new employees. Selected to meet a U.S. Congressman on company strategy.',
  },
  {
    when: '2021 — 2023',
    role: 'Outside Services',
    org: 'The Highlands at Dove Mountain',
    note: 'Supported daily golf course operations; previously kitchen staff.',
  },
];

const education = [
  {
    when: '2023 — Dec 2027',
    role: 'B.S. Business (Artificial Intelligence)',
    org: 'Arizona State University',
    note: 'Expected graduation December 2027.',
  },
];

const skills = [
  'AI governance',
  'Risk management',
  'Business data analytics',
  'Project management',
  'SQL',
  'Python & Java',
  'AWS Cloud',
  'Microsoft Excel',
  'Google Workspace',
  'Adobe Photoshop',
  'Project coordination',
  'Stakeholder communication',
  'Scheduling & organization',
];

const contacts = [
  { label: 'Email', value: 'therealmaxalexander@gmail.com', href: 'mailto:therealmaxalexander@gmail.com' },
  { label: 'LinkedIn', value: 'in/maxwellalexander121', href: 'https://www.linkedin.com/in/maxwellalexander121/' },
  { label: 'GitHub', value: 'github.com/turbo121', href: 'https://github.com/turbo121' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>Max Alexander — Business & AI</title>
    <meta name="description" content="Max Alexander — Arizona State business student focused on AI, based in Tempe / Phoenix. Résumé, highlights and contact information." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <a class="wordmark" href="#top" aria-label="Max Alexander, home">
        <span class="monogram"><span>M</span><span>A</span></span>
        <span class="wordmark-text">Max Alexander</span>
      </a>
      <nav class="nav-links">
        <a href="#highlights">Highlights</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a class="nav-cta" href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <!-- Hero -->
      <section class="hero-wrap">
        <div class="hero">
          <div class="hero-top">
            <span class="status"><span class="dot"></span>Open to internships</span>
            <span class="hero-loc">Tempe / Phoenix, AZ</span>
          </div>
          <div class="hero-main">
            <p class="eyebrow eyebrow-light">Business &amp; Artificial Intelligence</p>
            <h1 class="hero-name">Max Alexander</h1>
          </div>
          <div class="hero-foot">
            <p class="hero-bio">Business student at Arizona State focused on AI governance, risk management, business data analytics and project management. I work with stakeholders to turn data into sound decisions and keep projects on schedule.</p>
            <div class="hero-ctas">
              <a class="btn btn-light" href="#contact">Get in touch</a>
              <a class="btn btn-ghost-light" href={resumeUrl} download>Download résumé</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="section stats-section" aria-label="At a glance">
        <div class="stats">
          {stats.map((s) => (
            <div class="stat">
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Highlights -->
      <section class="section" id="highlights">
        <div class="section-head">
          <p class="eyebrow">Highlights</p>
          <h2 class="display">Selected experience.</h2>
        </div>
        <div class="cards">
          {highlights.map((h) => (
            <article class="card">
              <div class="card-top">
                <span class="card-num">{h.num}</span>
                <span class="card-tag">{h.tag}</span>
              </div>
              <div class="card-body">
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="section" id="experience">
        <div class="section-head section-head-row">
          <div>
            <p class="eyebrow">Résumé</p>
            <h2 class="display">Experience &amp; education.</h2>
          </div>
          <a class="btn btn-outline" href={resumeUrl} download>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v9M4 7l4 4 4-4M2 14h12" stroke="currentColor" stroke-width="1.8"/></svg>
            Full résumé (PDF)
          </a>
        </div>

        <h3 class="group-label">Experience</h3>
        <div class="rows">
          {experience.map((e) => (
            <div class="row">
              <span class="row-when">{e.when}</span>
              <div class="row-main">
                <span class="row-role">{e.role}</span>
                <span class="row-org">{e.org}</span>
              </div>
              <span class="row-note">{e.note}</span>
            </div>
          ))}
        </div>

        <h3 class="group-label">Education</h3>
        <div class="rows">
          {education.map((e) => (
            <div class="row">
              <span class="row-when">{e.when}</span>
              <div class="row-main">
                <span class="row-role">{e.role}</span>
                <span class="row-org">{e.org}</span>
              </div>
              <span class="row-note">{e.note}</span>
            </div>
          ))}
        </div>

        <h3 class="group-label">Skills</h3>
        <ul class="chips">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <!-- About -->
      <section class="section about" id="about">
        <div class="about-copy">
          <p class="eyebrow">About</p>
          <h2 class="about-title">Business strategy, informed by artificial intelligence.</h2>
          <p class="about-body">I'm earning a B.S. in Business with a focus on Artificial Intelligence at Arizona State University. My work so far spans event programming, data management and customer operations, and I'm looking for an internship in AI governance, risk management, business data analytics or project management.</p>
        </div>
        <div class="bcard" aria-label="Contact card">
          <div class="bcard-top">
            <div>
              <p class="bcard-name">Max Alexander</p>
              <p class="bcard-title">Business (AI) · Arizona State University</p>
            </div>
            <span class="monogram monogram-lg"><span>M</span><span>A</span></span>
          </div>
          <div class="bcard-info">
            <a href="mailto:therealmaxalexander@gmail.com">therealmaxalexander@gmail.com</a>
            <span>Tempe / Phoenix, AZ</span>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact-wrap" id="contact">
        <div class="contact">
          <div class="contact-main">
            <div>
              <p class="eyebrow eyebrow-light">Contact</p>
              <h2 class="contact-title">Let's work together.</h2>
              <p class="contact-sub">Open to full or part-time internships. The fastest way to reach me is by email.</p>
            </div>
            <ul class="contact-list">
              {contacts.map((c) => (
                <li>
                  <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
                    <span class="contact-text">
                      <span class="contact-label">{c.label}</span>
                      <span class="contact-value">{c.value}</span>
                    </span>
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M5 13L13 5M6 5h7v7" stroke="currentColor" stroke-width="1.8"/></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <footer class="footer">
            <span>© 2026 Max Alexander</span>
            <span>Tempe / Phoenix, Arizona</span>
          </footer>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0a0a0a;
    --white: #ffffff;
    --surface: #f4f4f4;
    --muted: #6b6b6b;
    --body: #4a4a4a;
    --line: #e2e2e2;
    --dark-line: #2a2a2a;
    --dark-muted: #9a9a9a;
    --live: #3ecf6e;
    --display: 'Inter Tight', 'Inter', system-ui, sans-serif;
    --sans: 'Inter', system-ui, sans-serif;
    --gutter: 88px;
    --max: 1264px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--white); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; }

  .eyebrow { font-weight: 500; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .eyebrow-light { color: var(--dark-muted); }
  .display { font-family: var(--display); font-weight: 600; font-size: clamp(36px, 4.6vw, 60px); line-height: 1.04; letter-spacing: -0.03em; margin-top: 14px; }

  /* Nav */
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 24px 48px; position: sticky; top: 0; z-index: 10; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); }
  .wordmark { display: flex; align-items: center; gap: 12px; }
  .wordmark-text { font-family: var(--display); font-weight: 600; font-size: 17px; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 32px; }
  .nav-links a { font-weight: 500; font-size: 14px; color: var(--body); transition: color 0.15s; }
  .nav-links a:hover { color: var(--ink); }
  .nav-links .nav-cta { color: var(--white); background: var(--ink); padding: 10px 18px; border-radius: 6px; }
  .nav-links .nav-cta:hover { color: var(--white); opacity: 0.85; }
  .monogram { display: inline-flex; border: 1.5px solid var(--ink); height: 30px; font-family: var(--display); font-weight: 700; font-size: 14px; flex-shrink: 0; border-radius: 4px; overflow: hidden; }
  .monogram span { display: flex; align-items: center; justify-content: center; width: 26px; }
  .monogram span:first-child { background: var(--ink); color: var(--white); }
  .monogram-lg { height: 40px; font-size: 18px; }
  .monogram-lg span { width: 34px; }

  /* Hero */
  .hero-wrap { padding: 0 24px; }
  .hero { background: var(--ink); color: var(--white); border-radius: 20px; min-height: min(720px, calc(100vh - 100px)); padding: 40px 64px 64px; display: flex; flex-direction: column; justify-content: space-between; gap: 64px; }
  .hero-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid var(--dark-line); border-radius: 999px; font-size: 13px; font-weight: 500; color: #d6d6d6; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 4px rgba(62, 207, 110, 0.15); }
  .hero-loc { font-size: 13px; font-weight: 500; color: var(--dark-muted); }
  .hero-main { display: flex; flex-direction: column; gap: 20px; }
  .hero-name { font-family: var(--display); font-weight: 600; font-size: clamp(56px, 10.5vw, 160px); line-height: 0.92; letter-spacing: -0.045em; }
  .hero-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; padding-top: 32px; border-top: 1px solid var(--dark-line); }
  .hero-bio { font-size: 18px; line-height: 29px; color: #cfcfcf; max-width: 560px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn { display: inline-flex; align-items: center; gap: 10px; padding: 15px 26px; border-radius: 6px; border: 1.5px solid; font-weight: 600; font-size: 14px; transition: background 0.15s, color 0.15s, opacity 0.15s; }
  .btn-light { background: var(--white); border-color: var(--white); color: var(--ink); }
  .btn-light:hover { opacity: 0.88; }
  .btn-ghost-light { border-color: #4a4a4a; color: var(--white); }
  .btn-ghost-light:hover { border-color: var(--white); }
  .btn-outline { border-color: var(--ink); padding: 12px 20px; }
  .btn-outline:hover { background: var(--ink); color: var(--white); }

  /* Sections */
  .section { padding: 128px var(--gutter) 0; max-width: calc(var(--max) + var(--gutter) * 2); margin: 0 auto; }
  .section-head { margin-bottom: 48px; }
  .section-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }

  /* Stats */
  .stats-section { padding-top: 64px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); }
  .stat { display: flex; flex-direction: column; gap: 8px; padding: 8px 32px; border-left: 1px solid var(--line); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat-value { font-family: var(--display); font-weight: 600; font-size: clamp(36px, 4vw, 52px); line-height: 1.05; letter-spacing: -0.035em; }
  .stat-label { font-size: 15px; color: var(--body); }

  /* Highlight cards */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { background: var(--surface); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; gap: 72px; min-height: 360px; transition: background 0.2s; }
  .card:hover { background: #ececec; }
  .card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .card-num { font-family: var(--display); font-weight: 600; font-size: 15px; }
  .card-tag { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); text-align: right; }
  .card-body { display: flex; flex-direction: column; gap: 12px; }
  .card-body h3 { font-family: var(--display); font-weight: 600; font-size: 26px; line-height: 1.15; letter-spacing: -0.02em; }
  .card-body p { font-size: 15px; line-height: 24px; color: var(--body); }

  /* Experience */
  .group-label { font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); padding-bottom: 16px; border-bottom: 1px solid var(--ink); margin-top: 48px; }
  .section-head + .group-label { margin-top: 0; }
  .row { display: grid; grid-template-columns: 200px 1fr 1fr; gap: 32px; align-items: baseline; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .row-when { font-size: 14px; font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; }
  .row-main { display: flex; flex-direction: column; gap: 4px; }
  .row-role { font-family: var(--display); font-weight: 600; font-size: 24px; letter-spacing: -0.02em; }
  .row-org { font-size: 16px; font-weight: 500; color: var(--body); }
  .row-note { font-size: 15px; line-height: 24px; color: var(--body); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 24px; }
  .chips li { border: 1px solid var(--line); padding: 8px 16px; border-radius: 999px; font-weight: 500; font-size: 14px; }

  /* About */
  .about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 96px; align-items: center; }
  .about-copy { display: flex; flex-direction: column; gap: 20px; }
  .about-title { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 3.2vw, 42px); line-height: 1.15; letter-spacing: -0.03em; }
  .about-body { font-size: 17px; line-height: 29px; color: var(--body); }
  .bcard { aspect-ratio: 1.75 / 1; width: 100%; max-width: 520px; justify-self: end; padding: 36px; background: var(--white); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 24px 48px -16px rgba(0,0,0,0.14); display: flex; flex-direction: column; justify-content: space-between; }
  .bcard-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .bcard-name { font-family: var(--display); font-weight: 600; font-size: 28px; letter-spacing: -0.025em; }
  .bcard-title { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  .bcard-info { display: flex; flex-direction: column; gap: 6px; font-size: 15px; font-weight: 500; }
  .bcard-info span { color: var(--muted); }
  .bcard-info a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Contact */
  .contact-wrap { padding: 128px 24px 24px; }
  .contact { background: var(--ink); color: var(--white); border-radius: 20px; overflow: hidden; }
  .contact-main { display: grid; grid-template-columns: 1fr 420px; gap: 64px; align-items: end; padding: 96px 64px 72px; }
  .contact-title { font-family: var(--display); font-weight: 600; font-size: clamp(44px, 6.4vw, 92px); line-height: 0.98; letter-spacing: -0.04em; margin-top: 20px; }
  .contact-sub { font-size: 17px; line-height: 28px; color: #cfcfcf; margin-top: 24px; max-width: 440px; }
  .contact-list { border-top: 1px solid var(--dark-line); }
  .contact-list a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--dark-line); color: var(--dark-muted); }
  .contact-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .contact-label { font-weight: 500; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .contact-value { font-weight: 500; font-size: 18px; color: var(--white); overflow-wrap: anywhere; }
  .contact-list a:hover { color: var(--white); }
  .contact-list a:hover .contact-value { text-decoration: underline; text-underline-offset: 4px; }
  .footer { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 64px; border-top: 1px solid var(--dark-line); font-size: 13px; color: var(--dark-muted); }

  /* Tablet */
  @media (max-width: 1100px) {
    :root { --gutter: 48px; }
    .nav { padding: 20px 32px; }
    .hero { padding: 32px 40px 48px; }
    .cards { grid-template-columns: 1fr; }
    .card { min-height: 0; gap: 48px; }
    .row { grid-template-columns: 160px 1fr; }
    .row-note { grid-column: 2; }
    .about { grid-template-columns: 1fr; gap: 48px; }
    .bcard { justify-self: start; }
    .contact-main { grid-template-columns: 1fr; padding: 72px 40px 56px; }
    .footer { padding: 24px 40px; }
  }

  /* Phone */
  @media (max-width: 720px) {
    :root { --gutter: 16px; }
    .nav { padding: 14px 16px; }
    .nav-links a:not(.nav-cta) { display: none; }
    .wordmark-text { font-size: 15px; }
    .hero-wrap { padding: 0 8px; }
    .hero { min-height: 600px; padding: 24px 20px 28px; border-radius: 16px; gap: 40px; }
    .hero-loc { display: none; }
    .hero-name { font-size: clamp(52px, 17vw, 80px); line-height: 0.95; }
    .hero-foot { flex-direction: column; align-items: stretch; gap: 24px; padding-top: 24px; }
    .hero-bio { font-size: 16px; line-height: 26px; }
    .hero-ctas .btn { flex: 1; justify-content: center; padding: 14px 12px; }
    .section { padding-top: 88px; }
    .stats-section { padding-top: 48px; }
    .stats { grid-template-columns: 1fr; }
    .stat { padding: 20px 0; border-left: 0; border-top: 1px solid var(--line); }
    .stat:first-child { border-top: 0; padding-top: 0; }
    .card { padding: 24px; }
    .card-body h3 { font-size: 22px; }
    .row { grid-template-columns: 1fr; gap: 8px; padding: 22px 0; }
    .row-note { grid-column: auto; }
    .row-role { font-size: 21px; }
    .bcard { aspect-ratio: auto; padding: 24px; gap: 40px; }
    .bcard-name { font-size: 22px; }
    .bcard-title { font-size: 11px; }
    .bcard-info { font-size: 14px; }
    .contact-wrap { padding: 88px 8px 8px; }
    .contact { border-radius: 16px; }
    .contact-main { padding: 48px 20px 32px; gap: 40px; }
    .contact-value { font-size: 16px; }
    .footer { padding: 20px; flex-direction: column; gap: 4px; }
  }
</style>
